<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Requested only after explicit automatic carrier SMS opt-in and assistant-role selection. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- Requested only when the user explicitly enables local contact search. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Hidden profiles are accessible only while Grace holds the default HOME role. -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Actual widget binding is still granted by the user through Android's bind UI. -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET" tools:ignore="ProtectedPermissions" />
    <!-- Some OEM clocks, including Samsung's, protect SHOW_ALARMS with this permission. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="org.breezyweather.READ_PROVIDER" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <package android:name="com.example.notes" />
        <provider android:authorities="com.example.notes.capture" />
        <package android:name="org.breezyweather" />
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <package android:name="jp.naver.line.android" />
        <package android:name="com.beeper.android" />
        <package android:name="com.nextcloud.talk2" />
        <package android:name="im.molly.app" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="com.kakao.talk" />
        <package android:name="com.tencent.mm" />
        <package android:name="com.viber.voip" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.Slack" />
        <package android:name="com.microsoft.teams" />
        <package android:name="com.discord" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.groupme.android" />
        <package android:name="com.zing.zalo" />
        <package android:name="com.enflick.android.TextNow" />
        <package android:name="com.pinger.textfree" />
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GraceLauncher"
        tools:targetApi="33">
        <!-- The official Breezy notifier requires an exported receiver and defines no
             sender permission. Payloads are ignored; signals only coalesce a read of
             the permission-protected, package-verified provider while enabled. -->
        <receiver
            android:name=".platform.BreezyWeatherUpdateReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="org.breezyweather.ACTION_UPDATE_NOTIFIER" />
            </intent-filter>
        </receiver>
        <!-- System-managed binding for app notification previews and media sessions. -->
        <service
            android:name=".data.media.MediaNotificationListener"
            android:label="@string/media_service_name"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".platform.LockScreenAccessibilityService"
            android:label="@string/lock_screen_service_label"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_screen_accessibility_service" />
        </service>
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:theme="@style/Theme.GraceLauncher.Home"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".WidgetSetupActivity"
            android:exported="false"
            android:theme="@style/Theme.GraceLauncher.Settings" />
        <activity
            android:name=".SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:label="@string/grace_settings"
            android:theme="@style/Theme.GraceLauncher.Settings"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
