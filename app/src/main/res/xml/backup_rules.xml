<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules (API < 31). The memory mirror (notes in plain text for FTS) never leaves the device:
   it is rebuildable from the server and must not reach cloud backup.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="database" path="memory_mirror.db" />
    <exclude domain="database" path="memory_mirror.db-wal" />
    <exclude domain="database" path="memory_mirror.db-shm" />
    <exclude domain="database" path="memory_mirror.db-journal" />
</full-backup-content>
