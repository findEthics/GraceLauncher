<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules (API 31+). The memory mirror is excluded from cloud backup and device transfer.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="memory_mirror.db" />
        <exclude domain="database" path="memory_mirror.db-wal" />
        <exclude domain="database" path="memory_mirror.db-shm" />
        <exclude domain="database" path="memory_mirror.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="memory_mirror.db" />
        <exclude domain="database" path="memory_mirror.db-wal" />
        <exclude domain="database" path="memory_mirror.db-shm" />
        <exclude domain="database" path="memory_mirror.db-journal" />
    </device-transfer>
</data-extraction-rules>
